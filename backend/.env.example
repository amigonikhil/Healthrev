# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# All secrets come from the environment — none are hard-coded anywhere.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Used to verify end-user JWTs (Project Settings → API → JWT Secret). HS256.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Service-role key — server-side ONLY, bypasses RLS. Keep out of the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Encryption (M1) ---
# Fernet key for encrypting wearable OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-key

# --- Whoop OAuth (M1) — free developer app at https://developer.whoop.com ---
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_REDIRECT_URI=http://localhost:8000/wearables/whoop/callback

# --- App ---
# Comma-separated allowed origins for CORS (mobile dev, etc.).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
ENVIRONMENT=development
# Log level: keep PHI out of logs at every level.
LOG_LEVEL=INFO

# Demo mode: serves a clickable /demo walkthrough + /demo/token minter.
# MUST stay false/unset in production — it is an auth shortcut for the hosted demo.
DEMO_MODE=false
