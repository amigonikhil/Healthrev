# Copy to .env. Expo inlines EXPO_PUBLIC_* vars into the client bundle, so these
# are PUBLIC values only — the Supabase anon key is safe to ship; never put the
# service-role key or any secret here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base URL of the backend API (FastAPI). Use your machine's LAN IP on a device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
