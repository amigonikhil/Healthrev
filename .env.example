# ─── Supabase (client-safe) ───────────────────────────────────────────────
# Project URL and publishable/anon key. These are exposed to the browser and
# are safe to ship because Row-Level Security governs all access.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ─── Supabase (server-only — NEVER expose to the browser) ─────────────────
# Service-role key bypasses RLS. Only used in trusted server code (e.g. the
# admin bootstrap / future ingest jobs). Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────
# Public site URL, used to build magic-link / OTP email redirect targets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
