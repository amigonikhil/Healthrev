# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables.

# Supabase (project in Mumbai, ap-south-1). Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the public signing page, cron, feedback admin and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (signing links and email links use it).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# 32 random bytes, base64 or hex: `openssl rand -base64 32`. Encrypts PAN and bank numbers.
# Never change it after real users onboard, or their stored PAN/bank can't be decrypted.
ENCRYPTION_KEY=

# Resend (email): verified sending domain required.
RESEND_API_KEY=
RESEND_FROM=Creator Assist <hello@yourdomain.in>

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically.
CRON_SECRET=

# Set to "false" until Indian SMS (DLT templates) is live: sign-in then opens on the Email tab.
NEXT_PUBLIC_SMS_ENABLED=true

# "true" shows "Continue with Google" once the Google provider is enabled in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=false

# Testing only: show the brand's signing OTP on screen instead of emailing it. Never "true" in production.
ALLOW_OTP_PREVIEW=false

# Demo owner. Signing in with this number (or, while SMS is off, with DEMO_OWNER_EMAIL by email OTP)
# auto-creates the profile, seeds the demo data and unlocks /admin/feedback.
DEMO_OWNER_PHONE=+91XXXXXXXXXX
DEMO_OWNER_NAME=
DEMO_OWNER_HANDLE=
DEMO_OWNER_EMAIL=
DEMO_OWNER_CITY=Hyderabad
DEMO_OWNER_STATE=Telangana

# Only for `supabase start` locally (config.toml references them). Dummy values are fine.
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_MESSAGE_SERVICE_SID=MGxxxxxxxx
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=dummy
