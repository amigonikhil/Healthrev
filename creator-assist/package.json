{
  "name": "creator-assist",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @creator-assist/web dev",
    "build:web": "pnpm --filter @creator-assist/web build",
    "dev:mobile": "pnpm --filter @creator-assist/mobile start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "supabase": "2.122.0"
  }
}
